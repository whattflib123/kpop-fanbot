TELEGRAM_BOT_TOKEN=
# 頻道 -100xxxxxxxxxx 或 @channel_username
TELEGRAM_CHAT_ID=
# 系統警示私訊（翻譯失敗等）＋ Threads 發文前審核
TELEGRAM_ADMIN_CHAT_ID=
# 0 = 不審核，直接發 Threads
THREADS_REVIEW=1
# 審核沒回超過幾小時自動發
THREADS_REVIEW_HOURS=24
# 翻譯走 Claude API（按 token 計費）。有設下面的 CLAUDE_CODE_OAUTH_TOKEN 時只當備援（Claude Code 失敗才用）；留空 = 不備援
ANTHROPIC_API_KEY=
# 翻譯改走 Claude Code 訂閱額度（不花 API 費）：電腦跑 `claude setup-token` 拿長效 token（約一年）填這裡；留空 = 走 API
CLAUDE_CODE_OAUTH_TOKEN=
POLL_SECONDS=300
# 主迴圈卡住多久（秒）就自動結束讓 Docker 重開，0＝關（預設 2700）
WATCHDOG_SEC=2700
# 成員留言檢查間隔（預設 15 分）
COMMENT_POLL_SECONDS=900
# 成員留言彙整：同一篇最後一則成員留言之後安靜幾小時，TG／Threads 各發一則彙整
COMMENT_DIGEST_HOURS=2
# 私訊警示的開頭
BOT_NAME=fanbot
# 同一則翻譯失敗幾次就放棄
TRANSLATE_MAX_ATTEMPTS=12
# Weverse 直播回放存檔資料夾（容器內路徑，例如 /app/data/weverse_live）；留空 = 不存
LIVE_ARCHIVE_DIR=
# 直播存檔後用 Claude Code 產統整＋爆點（要 CLAUDE_CODE_OAUTH_TOKEN 和 LIVE_ARCHIVE_DIR）；0 = 關
LIVE_SUMMARY=1
# 官方 YT 長片存檔＋統整＋中文外掛字幕：config.json 的 youtube_channels 標 "archive": true 的頻道才做；資料夾（容器內路徑，要在 docker-compose 掛 volume），留空 = 不做
YT_ARCHIVE_DIR=
# 0 = 關官方 YT 存檔
YT_ARCHIVE=1
# 短於幾秒的影片不存
YT_ARCHIVE_MIN_SEC=180
# 留空 = 不發 Threads
THREADS_ACCESS_TOKEN=
# 只有 threads_setup.py 換長效 token 時用
THREADS_APP_SECRET=

# Instagram（meta_setup.py 會寫入 META_PAGE_TOKEN、META_IG_USER_ID）
META_USER_TOKEN=
META_APP_SECRET=
# IG 輪詢間隔（比 POLL_SECONDS 慢，避免限流）
IG_POLL_SECONDS=900
# IG 排程短影音發佈失敗幾次就放棄（ig_schedule.py／ig_publish.py）
IG_MAX_ATTEMPTS=3
