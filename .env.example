TELEGRAM_BOT_TOKEN=
# 頻道 -100xxxxxxxxxx 或 @channel_username
TELEGRAM_CHAT_ID=
# 系統警示私訊（翻譯失敗等）＋ Threads 發文前審核
TELEGRAM_ADMIN_CHAT_ID=
# 0 = 不審核，直接發 Threads
THREADS_REVIEW=1
# 審核沒回超過幾小時自動發
THREADS_REVIEW_HOURS=24
ANTHROPIC_API_KEY=
POLL_SECONDS=300
# 主迴圈卡住多久（秒）就自動結束讓 Docker 重開，0＝關（預設 2700）
WATCHDOG_SEC=2700
# 成員留言檢查間隔（預設 15 分；同一輪內成員連回同一則留言會合成一則）
COMMENT_POLL_SECONDS=900
# 其他成員直接留言等幾分鐘沒人回才推（有成員回就由回覆那則帶出）
COMMENT_HOLD_MINUTES=60
# 私訊警示的開頭
BOT_NAME=fanbot
# 同一則翻譯失敗幾次就放棄
TRANSLATE_MAX_ATTEMPTS=12
# Weverse 直播回放存檔資料夾（容器內路徑，例如 /app/data/weverse_live）；留空 = 不存
LIVE_ARCHIVE_DIR=
# 留空 = 不發 Threads
THREADS_ACCESS_TOKEN=
# 只有 threads_setup.py 換長效 token 時用
THREADS_APP_SECRET=

# Instagram（meta_setup.py 會寫入 META_PAGE_TOKEN、META_IG_USER_ID）
META_USER_TOKEN=
META_APP_SECRET=
# IG 輪詢間隔（比 POLL_SECONDS 慢，避免限流）
IG_POLL_SECONDS=900
# IG 排程短影音發佈失敗幾次就放棄（ig_schedule.py／ig_publish.py）
IG_MAX_ATTEMPTS=3
